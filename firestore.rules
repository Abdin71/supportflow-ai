rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================================================
    // HELPER FUNCTIONS - Business Logic in Security Rules
    // ========================================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserRole(request.auth.uid) == 'admin';
    }
    
    function isAgent() {
      return isAuthenticated() && getUserRole(request.auth.uid) in ['agent', 'admin', 'manager'];
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if user exists in users collection (for validating ticket userId)
    function userExists(userId) {
      return userId == null || exists(/databases/$(database)/documents/users/$(userId));
    }
    
    // Validate ticket data structure
    function isValidTicketData(data) {
      return data.keys().hasAll(['subject', 'description', 'status']) &&
             data.subject is string && data.subject.size() >= 3 && data.subject.size() <= 200 &&
             data.description is string && data.description.size() >= 10 && data.description.size() <= 5000 &&
             data.status in ['open', 'in-progress', 'pending', 'resolved', 'closed'] &&
             // userId can be string or null (for anonymous tickets)
             (data.userId is string || data.userId == null);
    }
    
    // Validate status transitions
    function isValidStatusTransition(oldStatus, newStatus) {
      return (oldStatus == 'open' && newStatus in ['in-progress', 'pending', 'resolved', 'closed']) ||
             (oldStatus == 'in-progress' && newStatus in ['open', 'pending', 'resolved', 'closed']) ||
             (oldStatus == 'pending' && newStatus in ['open', 'in-progress', 'resolved', 'closed']) ||
             (oldStatus == 'resolved' && newStatus in ['open', 'in-progress', 'closed']) ||
             (oldStatus == 'closed' && newStatus in ['open']);
    }
    
    // Validate message data (for top-level messages collection)
    function isValidMessageData(data) {
      return data.keys().hasAll(['ticketId', 'text', 'userId', 'userName', 'role', 'createdAt']) &&
             data.ticketId is string &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 5000 &&
             data.userId is string &&
             data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100 &&
             data.role in ['user', 'agent'];
    }
    
    // Helper to get ticket data
    function getTicket(ticketId) {
      return get(/databases/$(database)/documents/tickets/$(ticketId)).data;
    }
    
    // Check if user can update specific ticket fields
    function canUpdateTicketFields(data) {
      let allowedFields = isAdmin() 
        ? ['status', 'priority', 'category', 'tags', 'assignedTo', 'updatedAt', 'hasUnreadMessages', 'messageCount']
        : ['status', 'updatedAt', 'hasUnreadMessages', 'assignedTo', 'messageCount'];
      
      return data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }
    
    // ========================================================================
    // USERS COLLECTION
    // ========================================================================
    
    match /users/{userId} {
      // Users can read their own profile, admins can read all
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can create their own profile during signup
      allow create: if isAuthenticated() && 
                       request.auth.uid == userId &&
                       request.resource.data.role == 'user'; // Prevent self-promotion to admin
      
      // Users can update their own profile (limited fields), admins can update any
      allow update: if isOwner(userId) && 
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['displayName', 'photoURL', 'phoneNumber', 'updatedAt'])
                    || isAdmin();
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }
    
    // ========================================================================
    // TICKETS COLLECTION - Primary Business Logic
    // ========================================================================
    
    match /tickets/{ticketId} {
      
      // READ: Users read own tickets, agents/admins read all
      allow read: if isAuthenticated() && 
                     (resource.data.userId == request.auth.uid || isAgent());
      
      // CREATE: Two scenarios supported
      allow create: if isAuthenticated() &&
                       isValidTicketData(request.resource.data) &&
                       request.resource.data.createdAt == request.time &&
                       request.resource.data.updatedAt == request.time &&
                       (
                         // Scenario A: User creates own ticket (must be 'open' status)
                         (request.resource.data.userId == request.auth.uid &&
                          getUserRole(request.auth.uid) == 'user' &&
                          request.resource.data.status == 'open') ||
                         
                         // Scenario B: Admin/Agent creates ticket for user
                         (isAgent() &&
                          // Validate user exists (or is null for anonymous)
                          userExists(request.resource.data.userId) &&
                          // Admins can set any status, priority, category, tags at creation
                          request.resource.data.status in ['open', 'in-progress', 'pending', 'resolved', 'closed'])
                       );
      
      // UPDATE: Agents can update tickets, users can update their own (limited fields)
      allow update: if isAuthenticated() &&
                       // Validate status transitions if status is being changed
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
                        isValidStatusTransition(resource.data.status, request.resource.data.status)) &&
                       // Check permissions based on role
                       (
                         // Users can update their own tickets (limited fields)
                         (resource.data.userId == request.auth.uid &&
                          request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['status', 'updatedAt', 'hasUnreadMessages'])) ||
                         
                         // Agents/Admins can update any ticket
                         (isAgent() && canUpdateTicketFields(request.resource.data)) ||
                         
                         // Assigned agents can update their assigned tickets
                         (resource.data.assignedTo == request.auth.uid &&
                          isAgent() &&
                          canUpdateTicketFields(request.resource.data))
                       );
      
      // DELETE: Only via Cloud Function for audit trail (disabled for direct access)
      allow delete: if false;
      
      // ======================================================================
      // ACTIVITY SUBCOLLECTION (Read-only, written by Cloud Functions)
      // ======================================================================
      
      match /activity/{activityId} {
        allow read: if isAuthenticated() &&
                       (get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId == request.auth.uid || isAdmin());
        allow write: if false; // Only Cloud Functions can write activity logs
      }
    }
    
    // ========================================================================
    // MESSAGES COLLECTION (Top-level for better scalability)
    // ========================================================================
    
    match /messages/{messageId} {
      
      // READ: Users can read messages for their tickets, agents can read all
      allow read: if isAuthenticated() &&
                     (getTicket(resource.data.ticketId).userId == request.auth.uid || isAgent());
      
      // CREATE: Users can add messages to their tickets, agents to any ticket
      allow create: if isAuthenticated() &&
                       isValidMessageData(request.resource.data) &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.createdAt == request.time &&
                       // Verify role matches user type
                       ((request.resource.data.role == 'user' && 
                         getTicket(request.resource.data.ticketId).userId == request.auth.uid) ||
                        (request.resource.data.role == 'agent' && isAgent()));
      
      // UPDATE: Users can edit their own messages within 5 minutes, agents anytime
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid &&
                       (request.time < resource.data.createdAt + duration.value(5, 'm') || isAgent()) &&
                       // Only text and isEdited can change
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['text', 'isEdited', 'editedAt']) &&
                       request.resource.data.isEdited == true;
      
      // DELETE: Only admins can delete messages
      allow delete: if isAdmin();
    }
    
    // ========================================================================
    // ANALYTICS COLLECTION (Admin only, written by Cloud Functions)
    // ========================================================================
    
    match /analytics/{document=**} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions can write analytics
    }
    
    // ========================================================================
    // NOTIFICATIONS COLLECTION
    // ========================================================================
    
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      
      // Users can mark their own notifications as read
      allow update: if isAuthenticated() && 
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['read', 'readAt']);
      
      // Only Cloud Functions can create/delete notifications
      allow create, delete: if false;
    }
  }
}
